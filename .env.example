# Local/dev secrets. Do not commit real values.
# 部署后用配置页（/admin?token=xxx）填这些更推荐，直接写入 D1

# 收录鉴权
INGEST_TOKEN=change-me-long-random-token

# 内容提取
TIKHUB_API_KEY=xxx
FIRECRAWL_API_KEY=xxx
VOLC_ACCESS_KEY=xxx
VOLC_SECRET_KEY=xxx

# AI 智能分析（OpenAI 兼容接口，如 DeepSeek/豆包/通义）
ARK_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Notion 写入
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_VERSION=2022-06-28

# Dify 知识库（可选）
DIFY_API_KEY=xxx
DIFY_DATASET_ID=xxx
DIFY_BASE_URL=https://api.dify.ai

# Jina Reader（可选）
JINA_API_KEY=xxx

# Bark 推送通知（可选）
BARK_KEY=xxx

DEFAULT_TOP_K=5
